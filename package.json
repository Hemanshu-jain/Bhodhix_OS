{
  "name": "bhodix-command-center",
  "version": "1.0.0",
  "description": "Bhodix Softwares Command Center - AI-native markdown project management, live server monitor, and finance engine",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/src/server.js",
    "desktop": "electron .",
    "package:win": "npm run build && node node_modules/electron-builder/cli.js --win nsis",
    "server": "node server/src/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "app": "node server/src/server.js",
    "test": "node --test \"server/test/*.test.js\"",
    "shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcuts.ps1"
  },
  "keywords": [
    "bhodix",
    "planner",
    "monitor",
    "finance",
    "vault"
  ],
  "author": "Bhodix Softwares",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  },
  "build": {
    "appId": "com.bhodix.os",
    "productName": "Bhodhix OS",
    "asar": true,
    "directories": { "output": "release" },
    "files": [
      "electron/**/*",
      "server/src/**/*",
      "server/package.json",
      "server/node_modules/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "electron/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
