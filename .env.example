# Replace these values before starting the container.
PUBLIC_BASE_URL=https://app.example.com
ALLOWED_HOSTS=app.example.com
ALLOWED_ORIGINS=https://app.example.com
HOST_PORT=4000
SMTP_URL=smtps://username:password@smtp.example.com:465
EMAIL_FROM="Bhodhix <noreply@example.com>"

# Encryption key shared by database monitor credentials, OAuth refresh tokens,
# web push subscriptions, and field-work photos. Use a persistent random 32-byte hex value.
# Desktop builds create a local key automatically in the app data folder.
CONNECTOR_TOKEN_ENCRYPTION_KEY=

# Optional Gmail + Google Calendar and Microsoft 365 integrations.
# Local desktop: use a Google Desktop OAuth client and enable public client
# flow for Microsoft. Google also needs its client secret value; it is not
# treated as a confidential secret for Google's desktop client type.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional hosted Web Push keys. Desktop builds generate and persist these keys.
# Generate with: node -e "console.log(JSON.stringify(require('./server/src/pushNotifications').generateVapidKeys()))"
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@example.com

# Optional scheduled AI reports. Set both values for each provider you want to enable.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional Slack workspace connection. Register this callback URL in your Slack app:
# https://app.example.com/api/slack/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Stable 32-byte hex key; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SLACK_TOKEN_ENCRYPTION_KEY=
